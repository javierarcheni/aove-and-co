---
interface Props {
  title?: string;
  description?: string;
  ruta?: string;
  imagen?: string;
  tipo?: 'website' | 'article';
}

const {
  title = 'AOVE & Co — Acercando el AOVE real al Levante',
  description = 'AOVE & Co (AOVE y Compañía): videopódcast, building in public hacia nuestra tienda en Valencia, catas pop-up y distribución de AOVE real en Levante.',
  ruta = '/',
  imagen = '/og-aove-co.jpg',
  tipo = 'website',
} = Astro.props;

const site = 'https://aove-and-co.netlify.app';
const url = `${site}${ruta}`;

import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#182311" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content="AOVE & Co — AOVE y Compañía" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${site}${imagen}`} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'AOVE & Co — AOVE y Compañía',
      url: site,
      logo: `${site}/favicon.svg`,
      description,
      areaServed: ['Valencia', 'Comunidad Valenciana', 'Levante'],
      sameAs: [],
      makesOffer: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Videopódcast sobre cultura del AOVE' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Catas y eventos pop-up en Valencia' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Distribución de AOVE artesanal en Levante' } },
      ],
    })} />
  </head>
  <body class="min-h-screen bg-ink-900 font-sans text-cream-100 antialiased">
    <slot />
    <a
      href="https://wa.me/34647539134?text=Hola%2C%20te%20escribo%20desde%20la%20web%20de%20AOVE%20%26%20Co"
      target="_blank"
      rel="noopener"
      aria-label="Escríbenos por WhatsApp"
      class="group fixed bottom-5 left-5 z-50 grid size-14 place-items-center rounded-full bg-brand-400 text-ink-950 shadow-xl shadow-black/40 transition hover:scale-105 hover:bg-brand-300"
    >
      <span class="absolute inset-0 animate-ping rounded-full bg-brand-400/30" aria-hidden="true"></span>
      <svg xmlns="http://www.w3.org/2000/svg" class="relative size-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
    </a>
  </body>
</html>
