---
import { Image } from 'astro:assets';
import heroOlivar from '../assets/hero/olivar.svg';
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-32 left-1/2 h-96 w-[60rem] -translate-x-1/2 rounded-full bg-brand-400/15 blur-3xl"></div>
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 sm:px-6 md:grid-cols-[1.1fr_0.9fr] md:py-20">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-brand-400/30 bg-brand-400/10 px-3 py-1 text-xs font-semibold text-brand-300">
        <span class="size-2 rounded-full bg-brand-400"></span>
        Desde Valencia · Puente con Jaén y el Levante
      </p>
      <h1 class="font-display mt-4 text-4xl leading-[1.05] font-bold text-balance sm:text-5xl lg:text-6xl">
        Acercando el AOVE real al Levante, <span class="text-brand-400">paso a paso hacia nuestra tienda.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-cream-300">
        Sin humo gourmet ni tecnicismos: videopódcast con productores, catas pop-up
        en Valencia y distribución honesta. Construimos en público hasta abrir la tienda física.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/videopodcast" class="rounded-full bg-brand-400 px-6 py-3 font-bold text-ink-950 transition hover:bg-brand-300">
          ▶ Ver último episodio
        </a>
        <a href="/eventos#reserva" class="rounded-full border border-white/20 px-6 py-3 font-semibold text-cream-50 transition hover:border-brand-400 hover:text-brand-300">
          Apuntarme a próximas catas
        </a>
      </div>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div><dt class="sr-only">Formato</dt><dd class="font-bold text-cream-50">Videopódcast + catas</dd><dd class="text-cream-500">cultura sin elitismos</dd></div>
        <div><dt class="sr-only">Objetivo</dt><dd class="font-bold text-cream-50">Tienda en Valencia</dd><dd class="text-cream-500">building in public</dd></div>
        <div><dt class="sr-only">Alianza</dt><dd class="font-bold text-cream-50">Oro Tradicional · Jaén</dd><dd class="text-cream-500">primer productor aliado</dd></div>
      </dl>
    </div>

    <div class="overflow-hidden rounded-3xl border border-white/10 bg-ink-800 shadow-2xl shadow-black/40">
      <Image src={heroOlivar} alt="Olivar de cosecha temprana" widths={[480, 800]} sizes="(max-width: 768px) 100vw, 45vw" loading="eager" class="aspect-[4/3] w-full object-cover opacity-90" />
      <div class="border-t border-white/10 p-5 text-sm" x-data="{ email: '', ok: false }">
        <p class="font-bold text-cream-50">Sigue el viaje: un email por semana, cero spam</p>
        <p class="mt-1 text-cream-300">Episodios, catas y decisiones de la tienda antes que nadie.</p>
        <form name="newsletter-hero" method="POST" action="/gracias/" data-netlify="true" netlify-honeypot="bot-field" class="mt-3 flex gap-2">
          <input type="hidden" name="form-name" value="newsletter-hero" />
          <p class="absolute top-auto -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true"><label>Si eres humano, deja esto vacío: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <label class="sr-only" for="nl-hero">Email</label>
          <input id="nl-hero" type="email" required placeholder="tu@email.com" name="email"
            class="min-w-0 flex-1 rounded-full border border-white/15 bg-ink-950 px-4 py-2.5 text-cream-50 placeholder:text-cream-500 outline-none focus:border-brand-400" />
          <button class="rounded-full bg-brand-400 px-5 py-2.5 font-bold whitespace-nowrap text-ink-950 hover:bg-brand-300">Unirme</button>
        </form>
      </div>
    </div>
  </div>
</section>
