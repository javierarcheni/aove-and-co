---
import SectionHeading from './SectionHeading.astro';
import { proximoEvento, eventosPasados } from '../data/contenido';
---

<section class="border-t border-white/10 bg-ink-950/50">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 md:grid-cols-2 md:py-18">
    <div>
      <SectionHeading
        kicker="Eventos · Valencia"
        titulo="Catas pop-up: oler, mojar y preguntar"
        texto="AOVE + pan de masa madre + quesos artesanos + producto de proximidad. Grupos pequeños en espacios singulares de Valencia."
      />
      <div class="mt-6 space-y-3">
        {eventosPasados.map((e) => (
          <div class="flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-ink-800 px-5 py-4 text-sm">
            <div>
              <p class="font-bold text-cream-50">{e.titulo} <span class="ml-2 rounded-full bg-white/10 px-2 py-0.5 text-xs">{e.asistencia}</span></p>
              <p class="mt-1 text-cream-300">{e.descripcion}</p>
            </div>
          </div>
        ))}
      </div>
      <a href="/eventos" class="mt-4 inline-block text-sm font-bold text-brand-300 hover:text-brand-200">Cómo son nuestras catas →</a>
    </div>

    <div id="reserva" class="scroll-mt-28 rounded-3xl border border-brand-400/30 bg-gradient-to-b from-brand-400/15 to-ink-800 p-6 sm:p-8">
      <p class="text-xs font-bold tracking-widest uppercase text-brand-300">Próximo encuentro · {proximoEvento.plazas} plazas</p>
      <h3 class="font-display mt-2 text-2xl font-bold text-cream-50">{proximoEvento.titulo}</h3>
      <p class="mt-2 text-sm text-cream-300">{proximoEvento.fecha} · {proximoEvento.lugar}</p>
      <p class="mt-3 text-sm leading-relaxed text-cream-100">{proximoEvento.descripcion}</p>
      <p class="mt-2 text-sm font-bold text-brand-300">{proximoEvento.precio}</p>
      <form
        name="lista-espera-catas"
        method="POST"
        action="/gracias/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-5 space-y-3"
      >
        <input type="hidden" name="form-name" value="lista-espera-catas" />
        <p class="absolute top-auto -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true"><label>Si eres humano, deja esto vacío: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="sr-only" for="ev-nombre">Nombre</label>
          <input id="ev-nombre" name="nombre" required placeholder="Tu nombre"
            class="rounded-xl border border-white/15 bg-ink-950 px-4 py-2.5 text-cream-50 placeholder:text-cream-500 outline-none focus:border-brand-400" />
          <label class="sr-only" for="ev-email">Email</label>
          <input id="ev-email" type="email" name="email" required placeholder="tu@email.com"
            class="rounded-xl border border-white/15 bg-ink-950 px-4 py-2.5 text-cream-50 placeholder:text-cream-500 outline-none focus:border-brand-400" />
        </div>
        <button class="w-full rounded-full bg-brand-400 py-3 font-bold text-ink-950 hover:bg-brand-300">Quiero aviso prioritario</button>
        <p class="text-xs text-cream-500">Plazas limitadas de verdad. Sin spam: solo aviso de catas en Valencia.</p>
      </form>
    </div>
  </div>
</section>
