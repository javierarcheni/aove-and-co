---
import SectionHeading from './SectionHeading.astro';
import { bitacora } from '../data/contenido';
---

<section class="border-t border-white/10">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-18">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        kicker="Building in public · Diario"
        titulo="El camino hacia la tienda, en abierto"
        texto="Números reales, errores y decisiones. Sin filtro: así se construye una tienda especializada desde cero."
      />
      <a href="/el-camino" class="text-sm font-bold text-brand-300 hover:text-brand-200">Leer la bitácora →</a>
    </div>

    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      {bitacora.map((e) => (
        <li class="rounded-3xl border border-white/10 bg-ink-800 p-6">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold tracking-widest uppercase text-brand-400">{e.hito}</span>
            <span class:list={[
              'rounded-full px-3 py-1 font-bold',
              e.estado === 'Hecho' ? 'bg-brand-400/15 text-brand-300' : 'bg-white/10 text-cream-100',
            ]}>{e.estado}</span>
          </div>
          <p class="mt-3 text-xs text-cream-500">{e.fecha}</p>
          <h3 class="font-display mt-1 text-xl font-bold text-cream-50">{e.titulo}</h3>
          <p class="mt-2 text-sm leading-relaxed text-cream-300">{e.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
