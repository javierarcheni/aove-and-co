---
interface Props {
  kicker?: string;
  titulo: string;
  texto?: string;
}

const { kicker, titulo, texto } = Astro.props;
---

<div class="max-w-2xl">
  {kicker && <p class="text-xs font-bold tracking-[0.2em] text-brand-400 uppercase">{kicker}</p>}
  <h2 class="font-display mt-2 text-3xl font-bold tracking-tight text-cream-50 text-balance sm:text-4xl">{titulo}</h2>
  {texto && <p class="mt-3 leading-relaxed text-cream-300">{texto}</p>}
</div>
