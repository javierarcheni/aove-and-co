---
import SectionHeading from './SectionHeading.astro';
import { episodios } from '../data/contenido';

const destacado = episodios[0];
---

<section class="border-t border-white/10 bg-ink-950/50">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-18">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        kicker="Videopódcast · Motor de autoridad"
        titulo="El último episodio, sin tecnicismos"
        texto="Entrevistas en almazara, catas guiadas y cultura del AOVE contada para gente normal."
      />
      <a href="/videopodcast" class="text-sm font-bold text-brand-300 hover:text-brand-200">Ver todos los episodios →</a>
    </div>

    <article class="mt-8 grid gap-6 rounded-3xl border border-white/10 bg-ink-800 p-4 sm:p-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="overflow-hidden rounded-2xl bg-black">
        <lite-youtube videoid={destacado.youtubeId} playlabel={destacado.titulo} style="width:100%;aspect-ratio:16/9;display:block"></lite-youtube>
        <script src="https://cdn.jsdelivr.net/npm/@justinribeiro/lite-youtube@1.5.0/lite-youtube.js" type="module"></script>
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest uppercase text-brand-400">Ep. {destacado.numero} · {destacado.categoria} · {destacado.duracion}</p>
        <h3 class="font-display mt-2 text-2xl font-bold text-cream-50">{destacado.titulo}</h3>
        <p class="mt-3 text-sm leading-relaxed text-cream-300">{destacado.resumen}</p>
        <ul class="mt-4 space-y-1.5 text-sm text-cream-100">
          {destacado.notas.map((n) => <li class="flex gap-2"><span class="text-brand-400">→</span> {n}</li>)}
        </ul>
        <div class="mt-5 flex flex-wrap gap-2 text-xs font-bold">
          <a href="https://youtube.com" target="_blank" rel="noopener" class="rounded-full border border-white/15 px-4 py-2 hover:border-brand-400 hover:text-brand-300">YouTube</a>
          <a href="https://open.spotify.com" target="_blank" rel="noopener" class="rounded-full border border-white/15 px-4 py-2 hover:border-brand-400 hover:text-brand-300">Spotify</a>
          <a href="https://podcasts.apple.com" target="_blank" rel="noopener" class="rounded-full border border-white/15 px-4 py-2 hover:border-brand-400 hover:text-brand-300">Apple Podcasts</a>
        </div>
      </div>
    </article>
  </div>
</section>
