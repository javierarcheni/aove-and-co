---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { pathFor } from '../../i18n/config'
import { t } from '../../i18n/ui'

const lang = 'en'
---

<BaseLayout
	title={t(lang, 'meta.privacy.title')}
	description={t(lang, 'meta.privacy.description')}
	ruta={pathFor('privacy', lang)}
>
	<Navbar />
	<main class="mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20">
		<p class="text-xs font-bold tracking-[0.2em] text-brand-400 uppercase">
			{t(lang, 'legal.eyebrow')}
		</p>
		<h1 class="font-display mt-2 text-4xl font-bold text-balance sm:text-5xl">
			Privacy policy
		</h1>
		<p class="mt-3 text-sm text-cream-500">{t(lang, 'legal.lastUpdate')}</p>
		<p class="mt-3 text-sm text-cream-500">
			English translation for information purposes only. The Spanish version is the
			binding one.
		</p>

		<div class="mt-8 space-y-6 leading-relaxed text-cream-100">
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">1. Controller</h2>
				<ul class="mt-2 list-disc pl-5 text-cream-300">
					<li>
						<strong>Controller:</strong> Francisco Javier Archeni Sanz (AOVE &amp;
						Co)
					</li>
					<li>
						<strong>Tax ID:</strong> 33459341E · <strong>Address:</strong> Valencia,
						Spain
					</li>
					<li><strong>Contact:</strong> hola@aoveyco.com</li>
				</ul>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					2. What data we collect
				</h2>
				<p class="mt-2 text-cream-300">
					Only what you send us through the contact form or by email: name, email
					address and the content of your message. We also keep minimal technical
					security logs (IP, headers) to prevent spam and abuse.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					3. What we use it for
				</h2>
				<p class="mt-2 text-cream-300">
					To reply to your message, manage possible collaborations (producers, shops,
					hospitality, tastings) and protect the site against spam. We do not send
					unsolicited commercial communications or share data for commercial
					purposes.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					4. Legal basis
				</h2>
				<p class="mt-2 text-cream-300">
					Your consent when submitting the form (mandatory acceptance checkbox),
					pre-contractual management if you request information or a quote, and
					legitimate interest in the security of the site.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					5. Who else processes it
				</h2>
				<ul class="mt-2 list-disc pl-5 text-cream-300">
					<li><strong>Netlify:</strong> hosting and technical form handling.</li>
					<li>
						<strong>Google Fonts:</strong> font loading (technical request with your
						IP to Google's server).
					</li>
					<li>
						<strong>YouTube:</strong> only if you play an embedded video in the video
						podcast section.
					</li>
				</ul>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">6. Retention</h2>
				<p class="mt-2 text-cream-300">
					We keep messages for as long as necessary to handle them and follow up, and
					delete them when they are no longer needed or you ask us to, unless legal
					obligations apply.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					7. Your rights
				</h2>
				<p class="mt-2 text-cream-300">
					Access, rectification, erasure, objection, restriction, portability and
					withdrawal of consent: write to hola@aoveyco.com stating the right you wish
					to exercise. If you believe we are not complying, you can complain to the
					Spanish Data Protection Agency (aepd.es).
				</p>
			</section>
		</div>
	</main>
	<Footer />
</BaseLayout>
