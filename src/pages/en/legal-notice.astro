---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { pathFor } from '../../i18n/config'
import { t } from '../../i18n/ui'

const lang = 'en'
---

<BaseLayout
	title={t(lang, 'meta.legal.title')}
	description={t(lang, 'meta.legal.description')}
	ruta={pathFor('legal', lang)}
>
	<Navbar />
	<main class="mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20">
		<p class="text-xs font-bold tracking-[0.2em] text-brand-400 uppercase">
			{t(lang, 'legal.eyebrow')}
		</p>
		<h1 class="font-display mt-2 text-4xl font-bold text-balance sm:text-5xl">
			Legal notice
		</h1>
		<p class="mt-3 text-sm text-cream-500">{t(lang, 'legal.lastUpdate')}</p>
		<p class="mt-3 text-sm text-cream-500">
			English translation for information purposes only. The Spanish version is the
			binding one.
		</p>

		<div class="mt-8 space-y-6 leading-relaxed text-cream-100">
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					1. Identifying information
				</h2>
				<p class="mt-2">
					In compliance with article 10 of Spanish Law 34/2002 (LSSI-CE), this
					website is owned by:
				</p>
				<ul class="mt-2 list-disc pl-5 text-cream-300">
					<li><strong>Owner:</strong> Francisco Javier Archeni Sanz</li>
					<li><strong>Tax ID (NIF):</strong> 33459341E</li>
					<li><strong>Professional address:</strong> Valencia, Spain</li>
					<li><strong>Contact:</strong> hola@aoveyco.com</li>
					<li>
						<strong>Activity:</strong> marketing, promotion and communication of
						extra virgin olive oil (AOVE &amp; Co).
					</li>
				</ul>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					2. Purpose and use of the site
				</h2>
				<p class="mt-2 text-cream-300">
					This site governs access to and use of its contents (texts, images, forms
					and videos). Access grants user status and implies acceptance of this
					notice. It is forbidden to use it for unlawful purposes, to attempt to
					damage its systems or forms, to impersonate identities or to reuse its
					contents for commercial purposes without written authorisation.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					3. Intellectual property
				</h2>
				<p class="mt-2 text-cream-300">
					Unless otherwise indicated, texts, photographs, logos, design and code are
					owned by AOVE &amp; Co. Viewing for personal and informative use is
					permitted, provided copyright notices are not altered.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					4. External links
				</h2>
				<p class="mt-2 text-cream-300">
					Links to third parties (e.g. YouTube, Spotify) are provided for reference.
					We do not control their content or policies; please review them at each
					destination.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">5. Liability</h2>
				<p class="mt-2 text-cream-300">
					We keep the site available and secure using reasonable measures, without
					guaranteeing the total absence of errors or interruptions. We are not
					liable for damages arising from misuse, decisions taken solely on the
					basis of informative content, or the actions of third parties.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					6. Data protection and cookies
				</h2>
				<p class="mt-2 text-cream-300">
					Data processing is described in the
					<a
						class="underline decoration-brand-400 underline-offset-4 hover:text-brand-300"
						href={pathFor('privacy', lang)}>privacy policy</a
					> and the use of cookies in the
					<a
						class="underline decoration-brand-400 underline-offset-4 hover:text-brand-300"
						href={pathFor('cookies', lang)}>cookie policy</a
					>.
				</p>
			</section>
			<section>
				<h2 class="font-display text-xl font-bold text-cream-50">
					7. Legislation and contact
				</h2>
				<p class="mt-2 text-cream-300">
					Spanish and European law applies. For any enquiry: hola@aoveyco.com.
				</p>
			</section>
		</div>
	</main>
	<Footer />
</BaseLayout>
