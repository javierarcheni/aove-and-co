---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { episodios } from '../data/contenido';
---

<BaseLayout
  title="Videopódcast AOVE & Co — Entrevistas, catas y cultura del AOVE"
  description="Episodios del videopódcast de AOVE & Co: entrevistas a productores como Oro Tradicional, catas guiadas y cultura del AOVE sin tecnicismos."
  ruta="/videopodcast"
  noindex
>
  <Navbar />
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <SectionHeading
      kicker="Videopódcast"
      titulo="Historias de almazara, contadas en persona"
      texto="Tres formatos: entrevistas a productores, cultura del AOVE y catas guiadas. Cada episodio deja resumen, notas y enlace al productor."
      h1
    />

    <div
      x-data="{ filtro: 'Todos' }"
      class="mt-8"
    >
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filtrar episodios">
        {['Todos', 'Entrevista', 'Cultura', 'Cata'].map((c) => (
          <button
            @click={`filtro = '${c}'`}
            :class={`filtro === '${c}' ? 'bg-brand-400 text-ink-950' : 'border border-white/15 text-cream-300'`}
            class="rounded-full px-4 py-2 text-sm font-bold transition"
          >
            {c}
          </button>
        ))}
      </div>

      <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {episodios.map((ep) => (
          <article
            x-show={`filtro === 'Todos' || filtro === '${ep.categoria}'`}
            x-transition.opacity
            class="flex flex-col rounded-3xl border border-white/10 bg-ink-800 p-6"
          >
            <p class="text-xs font-bold tracking-widest uppercase text-brand-400">Ep. {ep.numero} · {ep.categoria} · {ep.duracion}</p>
            <h2 class="font-display mt-2 text-xl font-bold text-cream-50">{ep.titulo}</h2>
            <p class="mt-2 text-sm leading-relaxed text-cream-300">{ep.resumen}</p>
            <ul class="mt-3 space-y-1 text-sm text-cream-100">
              {ep.notas.map((n) => <li class="flex gap-2"><span class="text-brand-400">→</span> {n}</li>)}
            </ul>
            <p class="mt-3 text-xs text-cream-500">Productor: <a class="underline underline-offset-2 hover:text-brand-300" href={ep.productor.enlace}>{ep.productor.nombre} · {ep.productor.origen}</a></p>
            <div class="mt-4 flex flex-wrap gap-2 text-xs font-bold">
              <a href={`https://www.youtube.com/watch?v=${ep.youtubeId}`} target="_blank" rel="noopener" class="rounded-full bg-brand-400 px-4 py-2 text-ink-950 hover:bg-brand-300">Ver en YouTube</a>
              <a href="/eventos#reserva" class="rounded-full border border-white/15 px-4 py-2 hover:border-brand-400 hover:text-brand-300">Quiero catarlo</a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <aside class="mt-10 rounded-3xl border border-brand-400/30 bg-brand-400/10 p-6 text-sm sm:p-8">
      <h2 class="font-display text-xl font-bold text-cream-50">¿Te avisamos de cada episodio?</h2>
      <p class="mt-1 text-cream-300">Newsletter semanal + aviso de catas en Valencia. Nada más.</p>
      <form name="newsletter-videopodcast" method="POST" action="/gracias/" data-netlify="true" netlify-honeypot="bot-field" class="mt-4 flex flex-col gap-2 sm:flex-row">
        <input type="hidden" name="form-name" value="newsletter-videopodcast" />
        <p class="absolute top-auto -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true"><label>Si eres humano, deja esto vacío: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <label class="sr-only" for="nl-vp">Email</label>
        <label class="sr-only" for="nl-vp">Email</label>
        <input id="nl-vp" type="email" required name="email" placeholder="tu@email.com"
          class="flex-1 rounded-full border border-white/15 bg-ink-950 px-4 py-2.5 text-cream-50 placeholder:text-cream-500 outline-none focus:border-brand-400" />
        <button class="rounded-full bg-brand-400 px-6 py-2.5 font-bold text-ink-950 hover:bg-brand-300">Sigue el viaje</button>
      </form>
    </aside>
  </main>
  <Footer />
</BaseLayout>
