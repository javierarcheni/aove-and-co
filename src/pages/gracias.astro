---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout
  title="Gracias — AOVE & Co"
  description="Mensaje recibido. Te respondemos en 48h."
  ruta="/gracias/"
  noindex
>
  <Navbar />
  <main class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6 md:py-28">
    <p class="font-display text-6xl" aria-hidden="true">🫒</p>
    <h1 class="font-display mt-6 text-4xl font-bold text-balance sm:text-5xl">
      Mensaje <span class="text-brand-400">recibido.</span>
    </h1>
    <p class="mx-auto mt-4 max-w-md text-lg text-cream-300">
      Gracias por escribir. Te leo yo personalmente y respondo en 48h.
    </p>
    <a href="/" class="mt-8 inline-block rounded-full bg-brand-400 px-7 py-3 font-bold text-ink-950 hover:bg-brand-300">
      Volver al inicio
    </a>
  </main>
</BaseLayout>
