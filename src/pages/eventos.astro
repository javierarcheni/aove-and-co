---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { proximoEvento, eventosPasados } from '../data/contenido';
---

<BaseLayout
  title="Eventos y catas de AOVE en Valencia — AOVE & Co"
  description="Catas pop-up y maridajes de AOVE en Valencia: pan de masa madre, quesos artesanos y producto de proximidad. Reserva tu plaza o entra en lista de espera."
  ruta="/eventos"
>
  <Navbar />
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <SectionHeading
      kicker="Eventos y catas · Valencia"
      titulo="Probar antes de creer: así son nuestras catas"
      texto="Formato de 90 minutos: tres AOVEs guiados, maridaje con pan de masa madre, queso artesano y tomate de proximidad, y turno abierto de preguntas. Grupos de 20–24 para poder oler, mojar y hablar."
    />

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="rounded-3xl border border-brand-400/30 bg-ink-800 p-6 sm:p-8" id="reserva">
        <p class="text-xs font-bold tracking-widest uppercase text-brand-300">Próximo · {proximoEvento.plazas} plazas · Valencia</p>
        <h2 class="font-display mt-2 text-2xl font-bold text-cream-50">{proximoEvento.titulo}</h2>
        <p class="mt-2 text-sm text-cream-300">{proximoEvento.fecha} · {proximoEvento.lugar}</p>
        <p class="mt-3 text-sm leading-relaxed">{proximoEvento.descripcion}</p>
        <p class="mt-2 font-bold text-brand-300">{proximoEvento.precio}</p>
        <form name="reserva-evento" method="POST" action="/gracias/" data-netlify="true" netlify-honeypot="bot-field" class="mt-5 space-y-3">
          <input type="hidden" name="form-name" value="reserva-evento" />
          <p class="absolute top-auto -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true"><label>Si eres humano, deja esto vacío: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div class="grid gap-3 sm:grid-cols-2">
            <input name="nombre" required placeholder="Tu nombre" aria-label="Nombre"
              class="rounded-xl border border-white/15 bg-ink-950 px-4 py-2.5 text-cream-50 placeholder:text-cream-500 outline-none focus:border-brand-400" />
            <input name="email" type="email" required placeholder="tu@email.com" aria-label="Email"
              class="rounded-xl border border-white/15 bg-ink-950 px-4 py-2.5 text-cream-50 placeholder:text-cream-500 outline-none focus:border-brand-400" />
          </div>
          <label class="flex items-center gap-3 text-sm">Plazas
            <select name="plazas" class="rounded-xl border border-white/15 bg-ink-950 px-4 py-2.5">
              <option>1</option><option>2</option><option>3</option><option>4</option>
            </select>
          </label>
          <button class="w-full rounded-full bg-brand-400 py-3 font-bold text-ink-950 hover:bg-brand-300">Reservar / entrar en lista de espera</button>
        </form>
      </div>

      <div>
        <h2 class="font-bold text-cream-50">Prueba social: lo que ya pasó</h2>
        <div class="mt-4 space-y-3">
          {eventosPasados.map((e) => (
            <article class="rounded-2xl border border-white/10 bg-ink-800 p-5">
              <p class="font-bold text-cream-50">{e.titulo} · {e.fecha}</p>
              <p class="mt-1 text-sm text-cream-300">{e.descripcion}</p>
              <p class="mt-2 text-xs font-bold text-brand-300">{e.asistencia} · {e.lugar}</p>
            </article>
          ))}
        </div>
        <div class="mt-4 rounded-2xl border border-white/10 p-5 text-sm text-cream-300" x-data="{ open: 1 }">
          <p class="font-bold text-cream-50">¿Qué me llevo de una cata?</p>
          <button @click="open = open === 1 ? 0 : 1" class="mt-2 underline underline-offset-4">Ficha de cata para casa <span x-text="open === 1 ? '−' : '+'"></span></button>
          <div x-show="open === 1" x-transition class="mt-2">
            Saldrás distinguiendo frutado, amargo y picante, y sabiendo qué etiqueta merece tu dinero. Sin examen ni postureo.
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
